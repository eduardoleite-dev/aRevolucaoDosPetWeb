@page "/login"
@layout EmptyLayout
@inherits LoginPage

<PageTitle>Login | aRevolucaoDosPetWeb</PageTitle>

<main class="login-shell">
    <section class="login-story">
        <div class="brand">
            <div class="brand-mark">
                <svg class="icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="2.4"></circle><circle cx="16" cy="8" r="2.4"></circle><circle cx="5" cy="13.5" r="2"></circle><circle cx="19" cy="13.5" r="2"></circle><path d="M8 18.2c0-2.3 1.8-4.2 4-4.2s4 1.9 4 4.2c0 2-1.7 2.8-4 2.8s-4-.8-4-2.8Z"></path>
                </svg>
            </div>
            <div><span class="brand-overline">A revolução</span><strong>dos pets</strong></div>
        </div>

        <div class="story-content">
            <div class="eyebrow"><span class="eyebrow-dot"></span>A rede social que tem focinho</div>
            <h1>Um mundo<br/>melhor.<br/>Uma patinha de<br/>cada vez.</h1>
            <p>Conecte-se com quem entende que pet é família. Compartilhe momentos, encontre amizades e celebre cada aventura.</p>
            <div class="story-proof">
                <div class="avatar-stack">
                    <img src="https://images.unsplash.com/photo-1536589961747-e239b2abbec2?auto=format&fit=crop&w=100&q=85" alt="" />
                    <img src="https://images.unsplash.com/photo-1786945793054-8ca3f73efc1d?auto=format&fit=crop&w=100&q=85" alt="" />
                    <img src="https://images.unsplash.com/photo-1506891536236-3e07892564b7?auto=format&fit=crop&w=100&q=85" alt="" />
                </div>
            </div>
        </div>

        <div class="hero-pet">
            <img src="https://images.unsplash.com/photo-1782022491533-267c13b410bf?auto=format&fit=crop&w=1200&q=85" alt="Dois cachorros felizes" />
            <div class="floating-like">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path></svg>
            </div>
        </div>
        <p class="photo-credit">Foto: Alvan Nee / Unsplash</p>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="mobile-brand">
                <div class="brand brand-compact">
                    <div class="brand-mark"><svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="8" cy="8" r="2.4"></circle><circle cx="16" cy="8" r="2.4"></circle><circle cx="5" cy="13.5" r="2"></circle><circle cx="19" cy="13.5" r="2"></circle><path d="M8 18.2c0-2.3 1.8-4.2 4-4.2s4 1.9 4 4.2c0 2-1.7 2.8-4 2.8s-4-.8-4-2.8Z"></path></svg></div>
                    <div><span class="brand-overline">A revolução</span><strong>dos pets</strong></div>
                </div>
            </div>

            <div class="login-heading">
                <span>Bem-vindo de volta</span>
                <h2>Entre na sua matilha</h2>
                <p>Seus melhores amigos estão esperando por você.</p>
            </div>

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault>
                <label class="field">
                    <span>E-mail</span>
                    <div class="field-control">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                        <input id="username" type="email" @bind="username" autocomplete="username" placeholder="voce@email.com" disabled="@loading" />
                    </div>
                </label>

                <label class="field">
                    <span>Senha</span>
                    <div class="field-control">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
                        <input id="password" type="@(showPassword ? "text" : "password")" @bind="password" autocomplete="current-password" placeholder="Sua senha" disabled="@loading" />
                        <button type="button" class="icon-button field-action" @onclick="TogglePassword" aria-label="Mostrar senha">
                            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg>
                        </button>
                    </div>
                </label>

                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <p class="error" role="alert">@errorMessage</p> }

                <div class="form-options">
                    <label class="remember"><input type="checkbox" checked /><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"></path></svg></span> Lembrar de mim</label>
                    <button type="button" class="text-button">Esqueci minha senha</button>
                </div>

                <button class="primary-button login-button" type="submit" disabled="@loading">
                    @(loading ? "Entrando..." : "Entrar")
                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </button>
            </form>

            <div class="divider"><span>ou continue com</span></div>
            <button class="google-button" type="button"><span class="google-g">G</span> Google</button>
            
            <p class="signup">Ainda não faz parte? <button type="button" class="text-button" @onclick="GoToRegister">Criar uma conta</button></p>
        </div>
        <p class="login-footer">Ao entrar, você concorda com os <button>Termos de uso</button> e <button>Privacidade</button>.</p>
    </section>
</main>